<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- क्लाइंट ऐप के लिए ज़रूरी परमिशंस -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" /> <!-- QR स्कैन के लिए -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" /> <!-- IMEI निकालने के लिए -->
    
    <!-- बैकग्राउंड सर्विस और लॉक स्क्रीन के लिए -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="Smart Client App"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <!-- Device Admin Receiver -->
        <receiver 
            android:name=".MyAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data 
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Main Activity (यहाँ QR स्कैनर खुलेगा) -->
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lock Screen Activity -->
        <activity 
            android:name=".LockScreenActivity"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:exported="false" />

        <!-- Background Lock Service -->
        <service 
            android:name=".LockService" 
            android:exported="false" />

        <!-- Boot Receiver (फोन चालू होते ही सर्विस स्टार्ट करने के लिए) -->
        <receiver 
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
